:root {
    --primary-red: #C8102E;
    --primary-gold: #DFAC46;
    --gold-light: #F4D068;
    --dark-bg: #111116;
    --dark-card: #1A1A22;
    --text-light: #F5F5F7;
    --text-muted: #A0A0AB;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: var(--dark-bg);
    color: var(--text-light);
    line-height: 1.6;
}

/* Header */
header {
    background: rgba(17, 17, 22, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 2px solid var(--primary-gold);
    padding: 1rem 2rem;
    position: fixed;
    width: 100%;
    top: 0;
    z-index: 1000;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo-badge {
    color: var(--primary-gold);
    font-weight: 800;
    font-size: 1.4rem;
    letter-spacing: 1px;
}

.site-title {
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 2px;
}

nav ul {
    display: flex;
    list-style: none;
    gap: 1.5rem;
}

nav a {
    color: var(--text-light);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.3s;
}

nav a:hover {
    color: var(--primary-gold);
}

/* Hero Section */
.hero {
    min-height: 100vh;
    padding-top: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: linear-gradient(135deg, rgba(200, 16, 46, 0.2) 0%, rgba(17, 17, 22, 0.9) 100%);
}

.slogan-badge {
    display: inline-block;
    background: var(--primary-red);
    color: #fff;
    padding: 0.4rem 1.2rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 1rem;
}

.gold-gradient-text {
    font-size: 3rem;
    font-weight: 900;
    background: linear-gradient(180deg, #FFE58F 0%, #DFAC46 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 1rem;
}

.hero-subtitle {
    font-size: 1.2rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
}

.location-tag {
    color: var(--primary-gold);
    margin-bottom: 2rem;
}

.hero-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
}

.btn {
    padding: 0.8rem 1.8rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    transition: transform 0.2s, background 0.3s;
    cursor: pointer;
    border: none;
}

.btn-gold {
    background: var(--primary-gold);
    color: #000;
}

.btn-gold:hover {
    background: var(--gold-light);
    transform: translateY(-2px);
}

.btn-outline {
    border: 2px solid var(--primary-gold);
    color: var(--primary-gold);
    background: transparent;
}

.btn-outline:hover {
    background: rgba(223, 172, 70, 0.1);
    transform: translateY(-2px);
}

/* Sections */
.section {
    padding: 5rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
}

.bg-darker {
    background-color: #0A0A0D;
}

.section-title {
    text-align: center;
    font-size: 2rem;
    color: var(--primary-gold);
    margin-bottom: 3rem;
    position: relative;
}

.section-title::after {
    content: '';
    display: block;
    width: 60px;
    height: 3px;
    background: var(--primary-red);
    margin: 0.5rem auto 0;
}

/* Grids & Cards */
.grid-3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
}

.grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
}

.card {
    background: var(--dark-card);
    border: 1px solid rgba(223, 172, 70, 0.2);
    padding: 2rem;
    border-radius: 12px;
    text-align: center;
}

.card-icon {
    font-size: 2.5rem;
    color: var(--primary-gold);
    margin-bottom: 1rem;
}

.role-name {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--primary-gold);
    margin-top: 0.5rem;
}

.role-title {
    color: var(--text-muted);
    font-size: 0.9rem;
}

/* Kit Cards */
.kit-card {
    background: var(--dark-card);
    border-radius: 12px;
    padding: 2.5rem;
    position: relative;
    border-top: 5px solid var(--primary-gold);
}

.kit-card.domicile {
    border-color: var(--primary-red);
}

.kit-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(223, 172, 70, 0.15);
    color: var(--primary-gold);
    padding: 0.3rem 0.8rem;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 700;
}

.kit-colors span {
    color: var(--primary-gold);
    font-weight: 700;
}

.info-box {
    margin-top: 3rem;
    background: rgba(200, 16, 46, 0.1);
    border: 1px solid var(--primary-red);
    padding: 1.5rem;
    border-radius: 8px;
    text-align: center;
}

/* Form */
.contact-container {
    max-width: 600px;
    margin: 0 auto;
    background: var(--dark-card);
    padding: 2.5rem;
    border-radius: 12px;
    border: 1px solid rgba(223, 172, 70, 0.2);
}

.form-group {
    margin-bottom: 1.5rem;
}

.form-group label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--text-light);

}

.form-group input, .form-group select, .form-group textarea {
    width: 100%;
    padding: 0.8rem;
    background: #111116;
    border: 1px solid #333;
    border-radius: 6px;
    color: #fff;
}

.form-group input:focus, .form-group select:focus, .form-group textarea:focus {
    outline: none;
    border-color: var(--primary-gold);
}

.btn-full {
    width: 100%;
}

/* Footer */
footer {
    background: #050507;
    border-top: 1px solid #222;
    padding: 2rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.9rem;
}

.dev-signature {
    margin-top: 0.5rem;
    color: var(--primary-gold);
    font-weight: 600;
}

@media (max-width: 768px) {
    header {
        flex-direction: column;
        gap: 1rem;
    }
    .gold-gradient-text {
        font-size: 2.2rem;
    }
}
