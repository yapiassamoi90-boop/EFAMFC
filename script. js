document.addEventListener('DOMContentLoaded', () => {
    const contactForm = document.getElementById('contactForm');

    if (contactForm) {
        contactForm.addEventListener('submit', (e) => {
            e.preventDefault();
            alert("Merci ! Votre message a bien été transmis au bureau de l'EFAM FC. Nous vous contacterons très rapidement.");
            contactForm.reset();
        });
    }
});
